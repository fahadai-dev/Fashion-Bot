{
  "version": 2,
  "builds": [
    { "src": "index.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/chat", "dest": "/index.js" },
    { "src": "/order", "dest": "/index.js" },
    { "src": "/admin/orders", "dest": "/index.js" },
    { "src": "/admin/chats", "dest": "/index.js" },
    { "src": "/admin", "dest": "/public/admin.html" },
    { "src": "/", "dest": "/public/chat.html" }
  ]
}
